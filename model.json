{
  "kind": "openai_tts_stream",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "OpenAI TTS Stream",
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "text_in",
        "title": "Texte",
        "accepts": [
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution",
        "transport": "message"
      },
      {
        "id": 2,
        "name": "command_in",
        "title": "Commande",
        "accepts": [
          "application/json"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution",
        "transport": "message"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "audio_out",
        "title": "Audio out",
        "emits": [
          "audio/*"
        ],
        "multiplicity": "many",
        "transport": "audio_stream",
        "audio_stream": {
          "codecs": [
            "opus"
          ],
          "sample_rates_hz": [
            48000
          ],
          "channels": [
            1,
            2
          ],
          "overflow_policy": "disconnect"
        }
      },
      {
        "id": 2,
        "name": "command_out",
        "title": "Command out",
        "emits": [
          "application/json"
        ],
        "multiplicity": "many",
        "transport": "message"
      }
    ]
  },
  "config": {
    "api_key_ref": "",
    "voice": "marin",
    "instructions": "",
    "speed": 1,
    "connect_timeout_sec": 10,
    "read_timeout_sec": 30,
    "max_audio_sec": 180
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false,
    "allow_required_input": false,
    "default_required": false,
    "max_inputs": 2,
    "max_outputs": 2,
    "default_input_accepts": [
      "text/plain",
      "message/*"
    ],
    "default_output_emits": [
      "audio/*"
    ],
    "default_multiplicity": "one"
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "generic_source": false,
    "centralized_executor": "generic",
    "supports_runtime_audio_streams": true,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "js",
        "path": "assets/js/common.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "js",
        "path": "assets/js/common.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      }
    ]
  }
}
